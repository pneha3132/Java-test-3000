public class NumberPattern {
    public static void main(String[] args) {
        int rows = 3;       
        int columns = 5;    
        int currentNum = 1; 

        for (int i = 1; i <= rows; i++) {
          
            for (int j = 1; j <= columns; j++) {
            
                System.out.print(currentNum + " ");
                currentNum++; 
            }
            
            System.out.println();
        }
    }
}
